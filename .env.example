# PostgreSQL (Neon.tech)
# Use the pooled connection string for DATABASE_URL (with -pooler suffix)
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech:5432/mamormeter?sslmode=require&pgbouncer=true&connection_limit=20"
# Use the direct (non-pooled) connection string for migrations
DIRECT_DATABASE_URL="postgresql://user:password@host.neon.tech:5432/mamormeter?sslmode=require"

# App URL
NEXT_PUBLIC_APP_URL="https://mamormeter.vercel.app"

# Admin secret for protected endpoints (e.g. POST /api/admin/reset)
# Use a cryptographically secure random string in production (e.g. openssl rand -hex 32)
ADMIN_SECRET="change-me"
